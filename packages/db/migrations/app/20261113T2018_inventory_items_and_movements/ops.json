        "description": "create table \"InventoryItem\"",
        "sql": "CREATE TABLE \"dentistry\".\"InventoryItem\" (\n  \"branchId\" uuid NOT NULL,\n  \"category\" text,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"createdByMembershipId\" uuid NOT NULL,\n  \"currency\" text DEFAULT 'BOB' NOT NULL,\n  \"currentStock\" int4 DEFAULT 0 NOT NULL,\n  \"deletedAt\" timestamptz,\n  \"description\" text,\n  \"id\" uuid NOT NULL,\n  \"isActive\" bool DEFAULT true NOT NULL,\n  \"minStock\" int4 DEFAULT 0 NOT NULL,\n  \"name\" text NOT NULL,\n  \"organizationId\" uuid NOT NULL,\n  \"rowVersion\" int4 DEFAULT 1 NOT NULL,\n  \"sku\" text NOT NULL,\n  \"unit\" text NOT NULL,\n  \"unitCostMinor\" int4,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"updatedByMembershipId\" uuid,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"inventory_item_currency_bbe8c718\" CHECK (\"currency\" ~ '^[A-Z]{3}$'),\n  CONSTRAINT \"inventory_item_current_stock_2a235ec0\" CHECK (\"currentStock\" >= 0),\n  CONSTRAINT \"inventory_item_min_stock_70584dcc\" CHECK (\"minStock\" >= 0),\n  CONSTRAINT \"inventory_item_name_0ae1ec01\" CHECK (length(btrim(\"name\")) > 0 AND length(btrim(\"sku\")) > 0 AND length(btrim(\"unit\")) > 0),\n  CONSTRAINT \"inventory_item_unit_cost_2d621560\" CHECK (\"unitCostMinor\" IS NULL OR \"unitCostMinor\" >= 0),\n  CONSTRAINT \"inventory_item_version_dd7c92f3\" CHECK (\"rowVersion\" > 0)\n)",
        "params": []
      }
    ],
    "postcheck": [
