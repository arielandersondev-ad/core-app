# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
NODE_ENV="development"
PORT=3004
FRONTEND_URL="http://localhost:3000,http://localhost:3001"
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
JWT_PUBLIC_KEY_PATH="secrets/jwt-public.pem"
JWT_ISSUER="core-auth"
JWT_DENTISTRY_AUDIENCE="dentistry-api"
# Almacenamiento de archivos clínicos (opcional). Sin estas variables los
# adjuntos quedan deshabilitados. Ver src/modules/clinical-file/README.md.
# STORAGE_PROVIDER="BACKBLAZE_B2"   # BACKBLAZE_B2 | AWS_S3 | CLOUDFLARE_R2 | MINIO
# STORAGE_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
# STORAGE_REGION="us-west-004"
# STORAGE_BUCKET="nombre-del-bucket"
# STORAGE_ACCESS_KEY_ID="keyID de la application key"
# STORAGE_SECRET_ACCESS_KEY="applicationKey"
# STORAGE_FORCE_PATH_STYLE="false"  # opcional; true por defecto solo en MINIO
