# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# JWT (RS256). Las claves se guardan en archivos PEM generados con:
#   node scripts/gen-jwt-keys.mjs
# Eso crea secrets/jwt-private.pem y secrets/jwt-public.pem (ignorados por git).
# El otro proyecto necesita SOLO jwt-public.pem para verificar los tokens.
JWT_PRIVATE_KEY_PATH="secrets/jwt-private.pem"
JWT_PUBLIC_KEY_PATH="secrets/jwt-public.pem"
JWT_ISSUER="core-auth"
JWT_CORE_AUDIENCE="core-api"
JWT_KEY_ID="core-auth-2026-01"
JWT_EXPIRES_IN_SECONDS="900"

# ID de la organización interna y códigos de roles que pueden leer usuarios en Core.
# Sin ambos valores, GET /users queda cerrado.
CORE_ADMIN_ORGANIZATION_ID="00000000-0000-0000-0000-000000000000"
