# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# JWT (RS256). Las claves se guardan en archivos PEM generados con:
#   node scripts/gen-jwt-keys.mjs
# Eso crea secrets/jwt-private.pem y secrets/jwt-public.pem (ignorados por git).
# El otro proyecto necesita SOLO jwt-public.pem para verificar los tokens.
JWT_PRIVATE_KEY_PATH="secrets/jwt-private.pem"
JWT_PUBLIC_KEY_PATH="secrets/jwt-public.pem"
JWT_ISSUER="core-auth"
JWT_AUDIENCE="core-services"
JWT_EXPIRES_IN="1h"
